# GEMINI_API_KEY: Optional Gemini AI API call support
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted
APP_URL="http://localhost:3000"

# LIVEKIT CLOUD CONFIGURATION (Optional for cloud WebRTC, fallback local mesh available)
# Get credentials for free at https://cloud.livekit.io
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-api-key"
LIVEKIT_API_SECRET="your-api-secret"

# SUPABASE CONFIGURATION (Optional for persistent auth & historical rooms)
# Get credentials at https://supabase.com
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
